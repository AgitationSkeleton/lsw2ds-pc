  "rom_confirmation": {
    "routine": "0x020104D0 - the actor render path, reached with the actor in r0/r4.",
    "what_it_proves": "The world matrix really is at actor +0x8C. The routine does add r0, r4, #0x8c at 0x02010530 and again at 0x02010540, passing it to 0x020CADC0 which applies it to the GPU. This was found first from live RAM by scanning for orthonormal 4x3 blocks; the ROM now confirms it independently, which is the BOTH tier: runtime and ROM evidence agree.",
    "sequence": [
      "0x02010508  MTX_PUSH (0x04000444) - push the current matrix",
      "0x0201053C  bl 0x01FFA6F8 with r0 = actor+0x8C, r1 = actor+0xC8, gated by the byte at +0xD0 - rebuilds the matrix from +0xC8 when that dirty flag is set",
      "0x02010544  bl 0x020CADC0 with r0 = actor+0x8C - applies the world matrix",
      "0x02010588  MTX_SCALE (0x0400046C) from +0xBC/+0xC0/+0xC4, each multiplied by +0x1A4 in 20.12 fixed point with rounding"
    ],
    "new_actor_fields": {
      "+0x8C": "world 4x3 matrix, applied to the GPU every frame",
      "+0xBC/+0xC0/+0xC4": "per-actor scale vector",
      "+0xC8": "rotation source that 0x01FFA6F8 converts into the +0x8C matrix",
      "+0xD0": "dirty flag - when set, the matrix is rebuilt from +0xC8",
      "+0xD1": "set to 1 when the rebuild happens",
      "+0x1A4": "global scale multiplier applied to the scale vector",
      "+0x0C": "halfword tested against 0x7E as a visibility/render gate at 0x020104F8"
    },
    "next": "Disassemble 0x01FFA6F8. It converts +0xC8 into a rotation matrix, so it is the games own rotation decode and is the most direct route to fixing the node-record rotation parse.",
    "gx_wrappers": {
      "note": "The routines the render path calls are thin GX wrappers: each writes a command code to GXFIFO (0x04000400) then tail-jumps to a data-copy routine.",
      "0x020CADA4": "writes 0x17 = MTX_LOAD_4x3",
      "0x020CADC0": "writes 0x19 = MTX_MULT_4x3 - this is what the actor render path calls with actor+0x8C",
      "0x020CADDC": "writes 0x1A = MTX_MULT_3x3",
      "0x020CADF8": "writes 0x34 = SHININESS",
      "what_it_settles": "The actor matrix at +0x8C is fed to MTX_MULT_4x3, so it is a standard DS 4x3: three basis vectors of three components each, then the translation last. That matches how it is being read - elements 9, 10 and 11 as translation - so the placement extraction is correct in format as well as location."
    }
  }
