+// SAY WHICH INSTRUCTION WROTE A WATCHED ADDRESS.
+//
+// Armed from LSW2_WRITE_WATCH (hex or decimal), read once at static-init time
+// before any guest code runs, so each store path only ever compares a global.
+// All three widths are watched - see runtime_arm.h for why the byte one is not
+// optional.
+//
+// WHY THIS EXISTS. A word in guest RAM is written on one console and not on
+// another, and the cheaper ways of finding the writer are exhausted: Ghidra
+// cannot resolve the literal pool that reaches it, and the branch ring is
+// filled by allocator churn during the very level load that does the writing.
+// unmapped() already proves this seam can name an instruction; this asks it the
+// same question about a chosen address.
+//
+// A NAMED FUNCTION, NOT A LAMBDA INITIALISER. `extern "C" uint32_t x = []{...}();`
+// makes GCC apply the extern storage class to the lambda's own locals. And the
+// reporter needs extern "C" because runtime_arm.h declares it inside an
+// extern "C" block; without it every C and C++ unit fails to link.
+static uint32_t lsw2_read_write_watch_env() {
+    const char* s = std::getenv("LSW2_WRITE_WATCH");
+    if (!s) return 0u;
+    char* end = nullptr;
+    const unsigned long v = std::strtoul(s, &end, 0);
+    return (end != s) ? uint32_t(v) : 0u;
+}
+
+extern "C" uint32_t g_runtime_write_watch = lsw2_read_write_watch_env();
+// LSW2_WRITE_WATCH_MASK: which address bits must match (default all). A
+// mirrored region is watched by masking the mirror bits away - ITCM repeats
+// every 32 KB below 0x02000000, so 0xFE007FFF with a watch of 0x400 catches
+// ITCM offset 0x400 through any mirror. Constant-initialised, so an unset
+// watch can never match before the environment is read.
+extern "C" uint32_t g_runtime_write_watch_mask = 0xFFFFFFFFu;
+static const bool lsw2_watch_mask_read = [] {
+    if (const char* s = std::getenv("LSW2_WRITE_WATCH_MASK")) {
+        char* end = nullptr;
+        const unsigned long v = std::strtoul(s, &end, 0);
+        if (end != s) g_runtime_write_watch_mask = uint32_t(v);
+    }
+    return true;
+}();
+
+// AND ONLY THE WRITES CARRYING A CHOSEN VALUE, when LSW2_WRITE_WATCH_VALUE is
+// also set. Unset means match every value, which is the original behaviour.
+//
+// WHY IT WAS NEEDED. The address filter is enough for a word in RAM that a
+// handful of instructions touch. It is useless against an I/O port: the
+// geometry engine's GXFIFO at 0x04000400 takes several thousand stores per
+// frame, so the report cap below is spent inside the first frame and none of
+// those reports is the one being looked for.
+//
+// The value is the discriminator that works there. A polygon's TEXIMAGE_PARAM
+// is a single distinctive word, so watching the FIFO for exactly that word
+// names the routine that submits that polygon and nothing else. That is how
+// the top-screen portrait's drawing code was found.
+//
+// THIS LIVES IN THE SAME PATCH AS THE WATCH ITSELF, deliberately. It was first
+// written as a separate patch 0011, and that could not work: it has to insert a
+// line INSIDE the function this patch adds, so the two patches could no longer
+// be applied or reversed independently and the build stopped with "0009 does
+// not apply and is not already applied". Two patches cannot each own part of
+// one function.
+static bool lsw2_watch_value_matches(uint32_t val) {
+    static bool have = false;
+    static uint32_t want = 0;
+    static bool read = false;
+    if (!read) {
+        read = true;
+        if (const char* s = std::getenv("LSW2_WRITE_WATCH_VALUE")) {
+            char* end = nullptr;
+            const unsigned long v = std::strtoul(s, &end, 0);
+            if (end != s) { want = uint32_t(v); have = true; }
+        }
+    }
+    return !have || val == want;
+}
+
+// TWO MORE KNOBS, for the same reason the value filter exists: a field that is
+// written every frame with a resting value drowns the cap before anything
+// interesting happens. NONZERO drops the resting writes; MAX raises the bound
+// when a burst is genuinely worth seeing. Both are read once.
+static bool lsw2_watch_drop_zero(uint32_t val) {
+    static bool read = false, skip = false;
+    if (!read) {
+        read = true;
+        if (const char* s = std::getenv("LSW2_WRITE_WATCH_NONZERO"))
+            skip = (s[0] != '\0' && s[0] != '0');
+    }
+    return skip && val == 0;
+}
+
+static int lsw2_watch_cap() {
+    static int cap = 0;
+    if (cap == 0) {
+        cap = 32;
+        if (const char* s = std::getenv("LSW2_WRITE_WATCH_MAX")) {
+            const long v = std::strtol(s, nullptr, 0);
+            if (v > 0 && v <= 4096) cap = int(v);
+        }
+    }
+    return cap;
+}
+
+extern "C" void runtime_note_watched_write(uint32_t addr, uint32_t val,
+                                              uint32_t width) {
+    if (!lsw2_watch_value_matches(val)) return;
+    if (lsw2_watch_drop_zero(val)) return;
+    // BOUNDED, AND IT SAYS SO WHEN THE BOUND BITES - the discipline the
+    // unmapped cap needed after its 64 was once read as a measurement.
+    static int seen = 0;
+    const int cap = lsw2_watch_cap();
+    if (seen >= cap) return;
+    ++seen;
+    std::fprintf(stderr,
+                 "[watch] ARM%c wrote %08X = %08X w=%u  pc=%08X lr=%08X "
+                 "r0=%08X r1=%08X r2=%08X r3=%08X r4=%08X r5=%08X\n",
+                 g_nds_active == NDS_ARM9 ? '9' : '7', addr, val, width,
+                 g_cpu.R[15], g_cpu.R[14], g_cpu.R[0], g_cpu.R[1], g_cpu.R[2],
+                 g_cpu.R[3], g_cpu.R[4], g_cpu.R[5]);
+    // AND WHO CALLED THE WRITER. lr names only the immediate caller, and a
+    // store inside a shared helper (an RNG draw, a memcpy) is written by the
+    // helper for every one of its callers. The runtime already keeps the guest
+    // return addresses it pushed for each BL; the innermost few of those are
+    // the chain that led here. LSW2_WRITE_WATCH_STACK=1 prints them.
+    static int stack_on = -1;
+    if (stack_on < 0) {
+        const char* s = std::getenv("LSW2_WRITE_WATCH_STACK");
+        stack_on = (s && s[0] != '\0' && s[0] != '0') ? 1 : 0;
+    }
+    if (stack_on == 1) {
+        const uint32_t depth = runtime_call_stack_depth();
+        const uint32_t* ret = runtime_call_stack_data();
+        std::fprintf(stderr, "[watch]   call stack (innermost first, depth %u):",
+                     unsigned(depth));
+        for (uint32_t i = 0; i < depth && i < 8u; ++i)
+            std::fprintf(stderr, " %08X", unsigned(ret[depth - 1u - i]));
+        std::fprintf(stderr, "\n");
+    }
+    if (seen == cap) {
+        std::fprintf(stderr,
+                     "[watch] ... %d watched writes reported; further ones "
+                     "are NOT shown. That is this log's limit, not the "
+                     "guest's.\n", cap);
+    }
+}
