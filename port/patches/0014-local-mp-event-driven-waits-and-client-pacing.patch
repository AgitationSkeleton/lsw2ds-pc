+    /* Block until the socket has a datagram or `deadline` passes. The MP exchange
+     * is a lockstep: the host blocks for its clients' replies, a client blocks for
+     * the host's next frame. Polling that with sleep_for(1ms) added a sleep tick
+     * (more under load) to every hand-off, several times a frame, on both sides;
+     * select() returns the moment the peer's datagram lands. */
+    void WaitReadable(std::chrono::steady_clock::time_point deadline) {
+#ifdef _WIN32
+        if (socket_ == INVALID_SOCKET) return;
+        const auto now = std::chrono::steady_clock::now();
+        if (now >= deadline) return;
+        const long long us = std::chrono::duration_cast<std::chrono::microseconds>(
+            deadline - now).count();
+        fd_set readable;
+        FD_ZERO(&readable);
+        FD_SET(socket_, &readable);
+        timeval tv{};
+        tv.tv_sec = static_cast<long>(us / 1000000);
+        tv.tv_usec = static_cast<long>(us % 1000000);
+        ::select(0, &readable, nullptr, nullptr, &tv);
+#else
+        (void)deadline;
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+#endif
+    }
+
+    /* MP event trace (LSW2_MP_TRACE=1, off by default): one line per bridge event
+     * with a steady-clock microsecond stamp shared by every process on the machine,
+     * so two consoles' logs merge into one timeline. */
+    static void MpTrace(const char* what, uint32_t a, uint64_t ts, long long waited) {
+        static const bool on = [] {
+            const char* e = std::getenv("LSW2_MP_TRACE");
+            return e && *e == '1';
+        }();
+        if (!on) return;
+        const long long now = std::chrono::duration_cast<std::chrono::microseconds>(
+            std::chrono::steady_clock::now().time_since_epoch()).count();
+        std::fprintf(stderr, "[mp-trace] %lld %s %u %llu %lld\n", now, what, a,
+                     static_cast<unsigned long long>(ts), waited);
+    }
+
+    /* MP-exchange profiler (LSW2_MP_PROF=1, off by default). Once per wall-clock
+     * second, per blocking wait (the parent's RecvReplies, the child's
+     * RecvHostPacket): how many calls, how much wall time they blocked in total,
+     * the longest single wait, and how many hit the 25ms deadline. Read against
+     * the fps line this says whether a connected frame is spent emulating or
+     * waiting on the other console, and how many exchanges one frame makes. */
+    enum { kProfReplies = 0, kProfHost = 1 };
+    static void MpProf(int kind, std::chrono::steady_clock::time_point t_start,
+                       bool timeout) {
+        static const bool on = [] {
+            const char* e = std::getenv("LSW2_MP_PROF");
+            return e && *e == '1';
+        }();
+        if (!on) return;
+        const auto now = std::chrono::steady_clock::now();
+        const double us =
+            std::chrono::duration<double, std::micro>(now - t_start).count();
+        static double sum[2] = {}; static double mx[2] = {};
+        static int n[2] = {}; static int to[2] = {};
+        static auto window = now;
+        sum[kind] += us; if (us > mx[kind]) mx[kind] = us; ++n[kind];
+        if (timeout) ++to[kind];
+        if (now - window < std::chrono::seconds(1)) return;
+        static const char* const kNames[2] = {"replies", "hostpkt"};
+        for (int k = 0; k < 2; ++k) {
+            if (!n[k]) continue;
+            std::fprintf(stderr,
+                         "[mp-prof] %s: %d calls/s, blocked %.1fms/s, max %.1fms, "
+                         "timeouts %d\n",
+                         kNames[k], n[k], sum[k] / 1000.0, mx[k] / 1000.0, to[k]);
+            sum[k] = 0.0; mx[k] = 0.0; n[k] = 0; to[k] = 0;
+        }
+        window = now;
+    }
+
