+// ndsrecomp: MP-client sync profiler (LSW2_MP_PROF=1, off by default). For each
+// host ACK, how far past it the client may run (runahead) before it must block
+// for the host's next frame; for each host CMD, how far (emulated us) that CMD
+// lay beyond the point the client was allowed to reach. A large gap means the
+// client idles blocked while the host emulates, then emulates while the host
+// idles blocked on its reply: the two consoles take turns instead of running
+// side by side.
+void Wifi::MPSyncProf(bool ack, u64 timestamp, u32 runahead)
+{
+    static const bool on = [] {
+        const char* e = getenv("LSW2_MP_PROF");
+        return e && *e == '1';
+    }();
+    if (!on) return;
+    static u64 allowed_until = 0;
+    static double run_sum = 0.0, gap_sum = 0.0;
+    static int acks = 0, cmds = 0;
+    if (ack)
+    {
+        allowed_until = timestamp + runahead;
+        run_sum += runahead;
+        ++acks;
+        return;
+    }
+    if (allowed_until && timestamp > allowed_until)
+        gap_sum += double(timestamp - allowed_until);
+    if (++cmds < 120) return;
+    Log(LogLevel::Info,
+        "[mp-prof] client: avg runahead %.0fus, avg CMD beyond allowed %.0fus (%d cmds, %d acks)\n",
+        acks ? run_sum / acks : 0.0, gap_sum / cmds, cmds, acks);
+    run_sum = gap_sum = 0.0;
+    acks = cmds = 0;
+}
